                <td class="px-3 sm:px-4 py-3 align-top">
                  <span class="font-mono text-[12px] text-brand-700 font-semibold whitespace-nowrap">B08.851.021</span>
                </td>
                <td class="px-3 sm:px-4 py-3 align-top text-ink-900 leading-snug">{name}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- ИФА aut. table -->
    <div>
      <h3 class="text-[20px] mb-4">ИФА — иммуноферментный анализ</h3>
