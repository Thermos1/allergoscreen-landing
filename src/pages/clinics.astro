            </tr>
          </thead>
          <tbody>
            {IFA_AUTOIMMUNE.map((row, i) => (
              <tr class={i % 2 === 0 ? "" : "bg-mist/40"}>
                <td class="px-3 sm:px-4 py-3 align-top">
                  <span class="font-mono text-[12px] text-brand-700 font-semibold whitespace-nowrap">{row.code}</span>
                </td>
                <td class="px-3 sm:px-4 py-3 align-top text-ink-900 leading-snug">{row.name}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ====== АЛЛЕРГОЛОГИЧЕСКИЕ ИССЛЕДОВАНИЯ ====== -->
  <section class="bg-mist border-y border-rule">
