---
// Top banner — legal-mandate link to the patient results portal (allergoscreen.bregis.kz).
// Per Kazakhstan medical-lab regulations, results must be retrieved via a secure portal,
// NOT via WhatsApp / phone. This banner stays site-wide; the sticky Header keeps a gold
// "Результаты" button visible after the banner scrolls out of view (mobile included).

import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale).bregis;
---

<div class="bg-ink-900 text-white border-b border-white/10">
  <div class="container-x py-2 sm:py-2.5 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="inline-flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <path d="M14 2v6h6" />
          <path d="m9 15 2 2 4-4" />
        </svg>
      </span>
      <span class="min-w-0 truncate text-[13px] sm:text-sm leading-tight">
        <span class="font-semibold">{s.label}</span>
        <span class="hidden md:inline text-white/70">— {s.body}</span>
      </span>
    </div>
    <a
      href="https://allergoscreen.bregis.kz/"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 flex-shrink-0 rounded-full bg-gold px-3 py-2 text-[12.5px] sm:text-[13.5px] font-semibold text-ink-900 whitespace-nowrap transition hover:bg-gold-200"
    >
      <span class="hidden sm:inline">{s.cta}</span>
      <span class="sm:hidden">{s.cta_short}</span>
      <span class="sr-only sm:hidden"> — {s.label}</span>
      <svg aria-hidden="true" class="h-3.5 w-3.5 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
